[Unit]
Description=PlayCarGame room API + static frontend
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/playcargame
Environment=PORT=3210
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/playcargame/server.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
